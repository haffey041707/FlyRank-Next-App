# =============================================================================
# AI Study Assistant — environment template
# -----------------------------------------------------------------------------
# This file is COMMITTED and must never contain real values.
#
#   cp .env.example .env.local     then fill in real values there
#
# .env.local is git-ignored. Next.js loads .env* into process.env; variables are
# server-only by default. Anything prefixed NEXT_PUBLIC_ is inlined into the
# browser bundle at build time and is publicly readable — so never put a
# credential behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Server-only — secrets. Never prefix these with NEXT_PUBLIC_.
# Readable only in Server Components, route handlers, and server actions.
# -----------------------------------------------------------------------------

# Claude API key, used server-side for study sessions, quizzes, and flashcards.
# Get one at https://console.anthropic.com/ — leave blank here.
ANTHROPIC_API_KEY=

# Deployment environment: development | preview | production
APP_ENV=development

# Reserved for later; uncomment when the feature lands.
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Public — inlined into the browser bundle. Safe, non-secret values only.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=AI Study Assistant

# Local default. On a deployed environment set this to that deployment's URL.
# NEXT_PUBLIC_* values are inlined at BUILD time, so changing this on the host
# requires a redeploy, not just a restart.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
